# Job-Agent V1 — Environment Variables
# Gmail and LLM calls go through Claude Code's MCP hooks — no OAuth keys needed here.
# Only runtime config lives in this file.

# ── Database ─────────────────────────────────────────────────────────────────
JOB_AGENT_DB=job_agent.db

# ── Your email (used as digest recipient and sent-from address) ───────────────
YOUR_EMAIL_ADDRESS=pranavpradhan00721@gmail.com
DIGEST_RECIPIENT=pranavpradhan00721@gmail.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=job_agent.log

# ── Optional: direct Anthropic API key ───────────────────────────────────────
# Only needed when running the pipeline as a STANDALONE Python script (not
# through Claude Code). When orchestrated by Claude Code, model calls go
# through the agent's own API access — leave this unset in that case.
# ANTHROPIC_API_KEY=

# ── MCP Gmail integration ─────────────────────────────────────────────────────
# Gmail is handled via Claude Code's MCP Gmail hook (no OAuth credentials).
# The job agent writes action manifests; Claude Code executes them via MCP.
# No credentials needed here.
